# ==============================================================================
# StreamP2P Monorepo .gitignore
# ==============================================================================

# 1. Dependencies & Package Managers
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 2. Production & Development Build Outputs
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# 3. Environment Variables, Secrets & API Keys
# CRITICAL: Never commit live TURN passwords or private keys
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# 4. OS & System Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 5. IDE & Editor Artifacts
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# 6. Testing & Coverage
coverage/
.nyc_output/
*.lcov

# 7. Coturn runtime logs & databases
*.pid
turnserver.log*
*.sqlite

